{
  "name": "@giftbot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./backup-restore-drill": {
      "types": "./dist/backup-restore-drill.d.ts",
      "import": "./dist/backup-restore-drill.js"
    }
  },
  "files": ["dist", "drizzle"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node dist/check.js",
    "migrate": "node dist/migrate.js",
    "test": "node --test dist/constraints.test.js",
    "restore-drill": "node dist/restore-drill.js",
    "backup-restore-drill": "node dist/backup-restore-drill.js"
  },
  "dependencies": {
    "@giftbot/config": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "drizzle-kit": "^0.31.4",
    "embedded-postgres": "^17.6.0-beta.15",
    "typescript": "^5.9.2"
  }
}
