# Environment template for local + Railway
# Copy to `.env` locally. On Railway set the same names as Variables.
# NEVER put real secrets into this file or commit `.env`.

# Telegram Bot API token from @BotFather (required in production).
BOT_TOKEN=

# Bot username without @ (used for referral deep links).
BOT_USERNAME=AZAROV_GiftBot

# Coins granted to both referrer and invitee when invitee links Kick.
# Default: 500
REFERRAL_REWARD=500

# Public HTTPS URL of this Mini App (Railway domain), e.g. https://azarov-giftbot-production.up.railway.app
# Used for the Telegram WebApp button and CORS allowlist.
# Must match BotFather → Bot Settings → Menu Button / Main Mini App URL.
WEBAPP_URL=https://azarov-giftbot-production.up.railway.app

# Channel for the Telegram subscribe task, e.g. @azarov222
# The bot (BOT_TOKEN) must be an administrator of this channel for getChatMember checks.
TELEGRAM_CHANNEL=@azarov222

# Kick OAuth (Developer portal → application credentials).
# Redirect URI must match Kick app settings exactly.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Production example:
# KICK_REDIRECT_URI=https://azarov-giftbot-production.up.railway.app/api/kick/callback
# If empty, defaults to ${WEBAPP_URL}/api/kick/callback
KICK_REDIRECT_URI=
# Kick channel slug for the follow task (no @). Default: azarov7777
KICK_REQUIRED_CHANNEL=azarov7777
# Required substring in Kick username/display name for kick-nickname task
# KICK_NICKNAME_TAG=AZAROV
# Minutes of chat inactivity before a watch session restarts (default 10)
# KICK_WATCH_ACTIVITY_WINDOW=10
# OAuth scopes used by the app: user:read channel:read
# In Kick Developer settings enable Webhooks → URL:
#   https://YOUR_DOMAIN/api/kick/webhooks
# (used as a backup signal for channel.followed events)
# HTTP port. Railway injects PORT automatically — do not hardcode it in production.
PORT=3001

# Bind address. Default 0.0.0.0 is correct for Railway. Override only if needed.
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Optional comma-separated browser origins. If empty, WEBAPP_URL origin is used.
# In development, localhost:5173 / 127.0.0.1:5173 are allowed by default when both are empty.
# Example: https://your-app.up.railway.app
CORS_ORIGINS=

# Admin moderation API key (header X-Admin-Key). Required in production, >= 32 chars.
ADMIN_API_KEY=

# Telegram user IDs allowed to moderate partner/Welvura submissions via bot buttons.
# Comma-separated, e.g. 123456789,987654321
# Get your ID from @userinfobot. Required for Approve/Reject in Telegram.
ADMIN_TELEGRAM_IDS=

# Optional chat/group ID where new partner submissions (with screenshot) are posted.
# If empty, each ADMIN_TELEGRAM_IDS user receives a private message instead.
# ADMIN_CHAT_ID=-1001234567890
ADMIN_CHAT_ID=

# REQUIRED on Railway: persistent JSON store directory (Volume mount).
# Without this, balances and completed tasks reset on every redeploy/restart.
# Local default: server/data
# Railway (required): /data
AZAROV_STORE_DIR=

# REQUIRED on Railway: persistent uploads directory on the same Volume.
# Local default: <project>/uploads
# Railway (required): /data/uploads
AZAROV_UPLOADS_DIR=

# Emergency only: allow boot with ephemeral disk (data WILL be wiped on redeploy).
# AZAROV_ALLOW_EPHEMERAL_STORE=1

# Frontend API base URL for Vite builds.
# Leave EMPTY for same-origin production (https://DOMAIN/api/...).
# Local Vite proxies /api → :3001, so leave empty in development too.
# VITE_API_URL=

# Bot username (no @) for Telegram Login Widget on the website.
# Must match BOT_USERNAME / BotFather. Domain of the site must be allowed in BotFather → Domain.
# VITE_TELEGRAM_BOT_USERNAME=AZAROV_GiftBot

# Website Telegram Login Widget uses the same BOT_TOKEN for hash verification.
# Sessions are HttpOnly cookies (azarov_sid). Mini App initData auth is unchanged.

# Production checklist (Railway):
# - NODE_ENV=production
# - BOT_TOKEN, BOT_USERNAME, WEBAPP_URL, ADMIN_API_KEY (>=32 chars)
# - REQUIRED: Volume mounted at /data + AZAROV_STORE_DIR=/data + AZAROV_UPLOADS_DIR=/data/uploads
# - Single replica only (JSON store is NOT multi-instance safe). railway.toml pins numReplicas=1.
# - File lock does not protect across Railway replicas — never scale this service horizontally.
# - Do not set AZAROV_ALLOW_MULTI_REPLICA=1 in production (emergency diagnostics only).
# - Check GET /api/health → store.persistent === true, store.singleReplicaRequired === true
# - Build: npm run build
# - Start: npm run start:production
