# Process-boot skeleton. Do not put production secrets in git.

NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=3001
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002

# Local Phase 2 Postgres from docker-compose.yml
DATABASE_URL=postgresql://giftbot:giftbot@127.0.0.1:5433/giftbot

# Required to serve POST /auth/* and POST /admin/* (not required for --check).
# Listening with DATABASE_URL also requires this for API and Bot.
# Production (NODE_ENV=production) fail-fast requires this for API and Bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Dev only. Persist Telegram updates through the same ingress path, then the bot job.
# Forbidden when NODE_ENV=production.
# TELEGRAM_LONG_POLLING=false

# Production-frozen auth defaults (@giftbot/auth):
# initData 1800s (session create only), Mini App session 2592000s, admin 7200s.
# Future auth_date skew max 60s. Optional overrides (AUTH_* or aliases):
# AUTH_INIT_DATA_MAX_AGE_SECONDS=1800
# AUTH_SESSION_TTL_SECONDS=2592000
# AUTH_ADMIN_SESSION_TTL_SECONDS=7200
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=1800
# MINI_APP_SESSION_TTL_SECONDS=2592000
# ADMIN_SESSION_TTL_SECONDS=7200

# Telegram webhook shared secret (required for production API).
# Kick Events webhooks use Kick's RSA public key, not a shared secret.
# TELEGRAM_WEBHOOK_SECRET=

# Kick OAuth (not required for --check / hello-health). POST /kick/oauth/start is 503 until all four are set.
# If any Kick OAuth var is set in production, all four are required.
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_REDIRECT_URI=http://127.0.0.1:3000/kick/oauth/callback
# KICK_TOKEN_ENCRYPTION_KEY=
# KICK_OAUTH_STATE_TTL_SECONDS=600

# TEMPORARY_UNCONFIRMED per-process memory rate limits. Not product quotas.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WEBHOOK_MAX_REQUESTS=300

# Production API (NODE_ENV=production) also requires:
# PUBLIC_BASE_URL=https://miniapp.example.invalid
# UPLOAD_DIR=/var/lib/azarov-giftbot/uploads
# FFMPEG_BIN=ffmpeg
# TRUST_PROXY=1
# CORS_ORIGINS=   # optional; defaults to PUBLIC_BASE_URL when set
# DB_POOL_MAX=    # optional; defaults api=20 worker=10 bot=5
# DB_CONNECT_TIMEOUT_SECONDS=10

# OBS Browser Source overlay. Long random secret. Never put in the Mini App bundle.
# STREAM_ALERTS_TOKEN=

# Mini App (`apps/web`) uses same-origin `/auth`, `/bootstrap`, `/sections`, `/kick`, `/games`.
# Vite dev proxies those paths to API_HOST:API_PORT. Do not put the bot token in the Web bundle.

# Local Mini App without Telegram (never enable in production).
# Requires NODE_ENV=development|test AND ALLOW_DEV_AUTH=true.
# Recommended: `pnpm dev:local` (or npm.cmd exec --yes -- pnpm@10.15.1 dev:local).
# Docker is optional: if Docker/Postgres :5433 is unavailable, embedded Postgres
# persists under .local-dev-pg/ (gitignored).
# Prints:
#   http://127.0.0.1:<vite-port>/?dev=user
#   http://127.0.0.1:<vite-port>/?dev=admin
ALLOW_DEV_AUTH=true

# Production host env is deploy/env/giftbot.env.example → /etc/azarov-giftbot/env (not in git).
# See DEPLOYMENT_V2.md. V1 import is tools/v1-importer only (not API/Bot/Worker).
