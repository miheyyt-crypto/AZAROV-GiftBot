# Host copy: /etc/azarov-giftbot/env (or /etc/giftbot/env if already provisioned).
# Do not commit a filled copy. systemd EnvironmentFile reads this path.

NODE_ENV=production
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=3001
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002

# Required for migrate and for API/Bot/Worker ready.
DATABASE_URL=

# Required when API or Bot listen with DATABASE_URL set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Required to accept Telegram webhook POSTs. Production uses webhooks, not long polling.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LONG_POLLING=false

# Public HTTPS Mini App origin (no trailing slash). Drives CORS default + runbook URLs.
PUBLIC_BASE_URL=
# TRUST_PROXY=1
# CORS_ORIGINS=

# Persistent Welvura screenshots (outside release tree; not publicly browsable).
UPLOAD_DIR=/var/lib/azarov-giftbot/uploads

# DB pools (optional). Defaults: API 20, Worker 10, Bot 5. Budget ≈ 35 + migrate reserve.
# DB_POOL_MAX=
# DB_CONNECT_TIMEOUT_SECONDS=10

# Kick Events use Kick's RSA public key. Do not set KICK_WEBHOOK_SECRET.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=
KICK_TOKEN_ENCRYPTION_KEY=

# Auth TTL defaults are frozen in @giftbot/auth (1800 / 2592000 / 7200).
# Override only if operations explicitly change them:
# AUTH_INIT_DATA_MAX_AGE_SECONDS=
# AUTH_SESSION_TTL_SECONDS=
# AUTH_ADMIN_SESSION_TTL_SECONDS=
# KICK_OAUTH_STATE_TTL_SECONDS=
# RATE_LIMIT_WINDOW_SECONDS=
# RATE_LIMIT_MAX_REQUESTS=
# RATE_LIMIT_WEBHOOK_MAX_REQUESTS=

# OBS Browser Source overlay. Long random secret. Never put in Mini App.
# STREAM_ALERTS_TOKEN=

# Local Piper TTS for overlay speech (Worker). Leave unset until a CC0 voice is chosen.
# STREAM_ALERTS_TTS_DIR=/var/lib/azarov-giftbot/stream-alerts-tts
# PIPER_BIN=/opt/giftbot/piper/piper
# PIPER_MODEL=/opt/giftbot/piper/voices/ru_RU-dmitri-medium.onnx
# PIPER_VOICE=dmitri
# PIPER_TIMEOUT_MS=20000

# Never set ALLOW_DEV_AUTH=true in production.
