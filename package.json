{
  "name": "azarov-giftbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server:dev\" \"npm run bot:dev\" \"vite\"",
    "dev:client": "vite",
    "server": "node server/index.mjs",
    "server:dev": "node --watch server/index.mjs",
    "bot": "node server/bot.mjs",
    "bot:dev": "node --watch server/bot.mjs",
    "start": "node server/index.mjs",
    "start:bot": "node server/bot.mjs",
    "start:production": "node server/production.mjs",
    "test": "node --test server/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^1.31.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
