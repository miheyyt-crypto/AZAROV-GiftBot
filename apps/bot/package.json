{
  "name": "@giftbot/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node dist/main.js --check",
    "start": "node dist/main.js",
    "test": "node --test --test-concurrency=1 dist/*.test.js"
  },
  "dependencies": {
    "@giftbot/config": "workspace:*",
    "@giftbot/db": "workspace:*",
    "@giftbot/domain": "workspace:*",
    "@giftbot/jobs": "workspace:*",
    "@giftbot/observability": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "grammy": "^1.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2"
  }
}
